--- a/elf/ldconfig.c
+++ b/elf/ldconfig.c
@@ -99,6 +99,33 @@
 /* Path to root for chroot.  */
 static char *opt_chroot;
 
+/* Syscall path translation does not rewrite strings stored in ld.so.cache.
+   Store real paths in the cache: the unprivileged Android loader does not
+   live in a chroot either. Keep Debian configuration files unmodified. */
+static char *
+rootfs_path (const char *path)
+{
+  const char root[] = "@TERMUX_PREFIX@";
+  size_t n = strlen (root);
+  bool prefixed = strncmp (path, root, n) == 0
+                  && (path[n] == '/' || path[n] == '\0');
+  /* Android exposes the same app directory through both aliases. */
+  if (strncmp (root, "/data/data/", 11) == 0
+      && strncmp (path, "/data/user/0/", 13) == 0)
+    {
+      n = strlen (root + 11);
+      prefixed |= strncmp (path + 13, root + 11, n) == 0
+                  && (path[13 + n] == '/' || path[13 + n] == '\0');
+    }
+  if (opt_chroot != NULL || path[0] != '/' || prefixed)
+    return xstrdup (path);
+  char *result;
+  if (asprintf (&result, "%s%s", root, path) < 0)
+    error (EXIT_FAILURE, 0, _("memory exhausted"));
+  return result;
+}
+
+
 /* Manually link given shared libraries.  */
 static int opt_manual_link;
 
@@ -395,6 +422,9 @@
       return;
     }
 
+  char *rooted = rootfs_path (entry->path);
+  free (entry->path);
+  entry->path = rooted;
   char *path = entry->path;
   if (opt_chroot != NULL)
     path = chroot_canon (opt_chroot, path);
@@ -1041,8 +1071,8 @@
     }
   else
     {
-      canon = filename;
-      file = fopen (filename, "r");
+      canon = rootfs_path (filename);
+      file = fopen (canon, "r");
     }
 
   if (file == NULL)
@@ -1137,7 +1167,11 @@
       free (canon);
     }
   else
-    result = glob64 (pattern, 0, NULL, &gl);
+    {
+      char *rooted = rootfs_path (pattern);
+      result = glob64 (rooted, 0, NULL, &gl);
+      free (rooted);
+    }
 
   switch (result)
     {
@@ -1184,6 +1218,18 @@
   /* Parse and process arguments.  */
   int remaining;
   argp_parse (&argp, argc, argv, 0, &remaining, NULL);
+
+  /* libc-bin postinst passes -r "$DPKG_ROOT". That is already our prefix,
+     including Android's /data/data and /data/user/0 aliases. */
+  if (opt_chroot != NULL)
+    {
+      struct stat requested, installed;
+      if (stat (opt_chroot, &requested) == 0
+          && stat ("@TERMUX_PREFIX@", &installed) == 0
+          && requested.st_dev == installed.st_dev
+          && requested.st_ino == installed.st_ino)
+        opt_chroot = NULL;
+    }
 
   /* Remaining arguments are additional directories if opt_manual_link
      is not set.  */
@@ -1227,6 +1273,8 @@
       strcpy (cache_file, LD_SO_CACHE);
     }
 
+  cache_file = rootfs_path (cache_file);
+
   if (config_file == NULL)
     config_file = LD_SO_CONF;
 
@@ -1275,7 +1323,11 @@
       int i;
 
       for (i = remaining; i < argc; ++i)
-	manual_link (argv[i]);
+        {
+          char *rooted = rootfs_path (argv[i]);
+          manual_link (rooted);
+          free (rooted);
+        }
 
       exit (0);
     }
