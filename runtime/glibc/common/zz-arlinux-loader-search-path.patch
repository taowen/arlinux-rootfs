--- a/elf/dl-load.c
+++ b/elf/dl-load.c
@@ -438,6 +438,42 @@
 
 static size_t max_dirnamelen;
 
+/* Keep namespace translation inside the loader: interposing dlopen loses
+   its caller and therefore the caller's RPATH/RUNPATH. The allocation is
+   owned by this function and remains owned by its caller after translation.
+   These are the same Debian FHS roots used by the process runtime. */
+static char *
+root_debian_path (char *path)
+{
+  static const char *const directories[] =
+    { "/usr", "/bin", "/sbin", "/lib", "/lib64", "/etc", "/opt", "/var" };
+  if (path == NULL)
+    return NULL;
+  for (size_t i = 0; i < sizeof (directories) / sizeof (directories[0]); ++i)
+    {
+      size_t n = strlen (directories[i]);
+      if (strncmp (path, directories[i], n) != 0
+          || (path[n] != '/' && path[n] != '\0'))
+        continue;
+      const char root[] = "@TERMUX_PREFIX@";
+      size_t root_len = sizeof (root) - 1;
+      size_t len = strlen (path);
+      /* fillin_rpath may append a slash after the terminating NUL. */
+      char *result = malloc (root_len + len + 2);
+      if (result == NULL)
+        {
+          free (path);
+          _dl_signal_error (ENOMEM, NULL, NULL,
+                            N_("cannot root library path"));
+        }
+      memcpy (result, root, root_len);
+      memcpy (result + root_len, path, len + 1);
+      free (path);
+      return result;
+    }
+  return path;
+}
+
 static struct r_search_path_elem **
 fillin_rpath (char *rpath, struct r_search_path_elem **result, const char *sep,
 	      const char *what, const char *where, struct link_map *l)
